    create  table
      "sales_finance"."analytics_dbt_test__audit"."assert_invoice_amount_matches_contract_price"
  
    
    as (
      
    
  -- Business rule: invoiced amount must equal billed parcels x contract price (tolerance 1 cent).
-- Returns every invoice that breaks the rule.
select
    invoice_id,
    customer_id,
    service_code,
    invoice_month,
    billed_parcels,
    contract_price,
    amount,
    expected_amount,
    amount_difference
from "sales_finance"."analytics_intermediate"."int_invoices_checked"
where is_amount_mismatch
  
  
    );
    
  
    
